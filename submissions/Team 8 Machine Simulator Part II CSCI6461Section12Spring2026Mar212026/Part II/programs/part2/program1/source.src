; Program 1 (Part 2): read 20 integers, echo them, and print closest to target.
; Note:
; - This ISA implementation uses a 5-bit address field in instructions.
; - Data is kept in a high-memory block addressed via X1 base indexing.

        LOC     0
        LDX     1,31        ; X1 <- DATA_BASE
        LDR     2,1,6       ; R2 <- 20 (input count)
        LDR     0,1,10      ; R0 <- 32767 (initial best diff)
        STR     0,1,3       ; BEST_DIFF <- 32767

; Read target number from keyboard
WTGT:   CHK     3,0
        JZ      3,0,WTGT
        IN      1,0         ; R1 <- target
        STR     1,1,1       ; TARGET <- R1

; Read 20 numbers, print each, and maintain closest value to TARGET.
LOOP:   CHK     3,0
        JZ      3,0,LOOP
        IN      0,0         ; R0 <- current input
        OUT     0,1         ; echo to printer
        STR     0,1,4       ; CUR <- R0
        SMR     0,1,1       ; R0 <- CUR - TARGET
        JGE     0,0,ABSOK
        NOT     0
        AIR     0,1         ; abs(CUR - TARGET)
ABSOK:  STR     0,1,5       ; CUR_ABS <- abs diff
        SMR     0,1,3       ; R0 <- CUR_ABS - BEST_DIFF
        JGE     0,0,NUPD    ; if >= 0, not better
        LDR     0,1,4
        STR     0,1,2       ; BEST_VAL <- CUR
        LDR     0,1,5
        STR     0,1,3       ; BEST_DIFF <- CUR_ABS
NUPD:   SIR     2,1
        JNE     2,0,LOOP

; Print target and closest value
        LDR     0,1,1
        OUT     0,1         ; print TARGET
        LDR     0,1,2
        OUT     0,1         ; print BEST_VAL
        HLT

; Keep DATA_BASE pointer in low memory so LDX can load it with addr<=31.
        LOC     31
        Data    64          ; DATA_BASE

; Data block at DATA_BASE (64). Accessed via X1 + offset.
        LOC     64
        Data    0           ; +0  RESERVED
        Data    0           ; +1  TARGET
        Data    0           ; +2  BEST_VAL
        Data    0           ; +3  BEST_DIFF
        Data    0           ; +4  CUR
        Data    0           ; +5  CUR_ABS
        Data    20          ; +6  COUNT_20
        Data    0           ; +7  RESERVED
        Data    0           ; +8  RESERVED
        Data    0           ; +9  RESERVED
        Data    32767       ; +10 MAX_DIFF_INIT
